<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid.Resources><Style TargetType="TextBox"><Setter Property="Padding" Value="8"/><Setter Property="Margin" Value="0,4,14,4"/><Setter Property="BorderBrush" Value="#DDE3EF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontSize" Value="12"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="HorizontalScrollBarVisibility" Value="Auto"/><Setter Property="VerticalScrollBarVisibility" Value="Auto"/></Style></Grid.Resources><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="100"/></Grid.RowDefinitions>
 <StackPanel Margin="0,0,0,16"><TextBlock Text="接口导入 YApi" FontSize="27" FontWeight="Bold"/><TextBlock Text="选择历史项目，重新扫描源码并上传；配置保存在本机。" Foreground="#8490A6" Margin="0,8,0,0"/></StackPanel>
 <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="18" Margin="0,0,0,14"><Grid>
 <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
 <Grid.Resources><Style TargetType="TextBox"><Setter Property="Padding" Value="8"/><Setter Property="Margin" Value="0,4,14,4"/><Setter Property="BorderBrush" Value="#DDE3EF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontSize" Value="12"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="HorizontalScrollBarVisibility" Value="Auto"/><Setter Property="VerticalScrollBarVisibility" Value="Auto"/></Style></Grid.Resources><Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="40"/><RowDefinition Height="40"/><RowDefinition Height="40"/><RowDefinition Height="40"/></Grid.RowDefinitions>
 <TextBlock Text="历史项目" VerticalAlignment="Center"/><ComboBox x:Name="History" Grid.Column="1" Margin="0,4,14,4"/><StackPanel Grid.Column="2" Grid.ColumnSpan="2" Orientation="Horizontal"><Button x:Name="New" Content="新建配置" Padding="12,7"/><Button x:Name="SaveProfile" Content="保存配置" Padding="12,7"/></StackPanel>
 <TextBlock Grid.Row="1" Text="配置名称" VerticalAlignment="Center"/><TextBox x:Name="ProfileName" Grid.Row="1" Grid.Column="1"/><TextBlock Grid.Row="1" Grid.Column="2" Text="YApi 地址" VerticalAlignment="Center"/><TextBox x:Name="Server" Grid.Row="1" Grid.Column="3"/>
 <TextBlock Grid.Row="2" Text="扫描目录" VerticalAlignment="Center"/><TextBox x:Name="ScanDirectory" Grid.Row="2" Grid.Column="1"/><TextBlock Grid.Row="2" Grid.Column="2" Text="类型解析根目录" VerticalAlignment="Center"/><TextBox x:Name="SourceRoot" Grid.Row="2" Grid.Column="3"/>
 <TextBlock Grid.Row="3" Text="项目 Token" VerticalAlignment="Center"/><PasswordBox x:Name="Token" Grid.Row="3" Grid.Column="1" Margin="0,4,14,4" Padding="8" BorderBrush="#DDE3EF"/><Button x:Name="Connect" Grid.Row="3" Grid.Column="2" Content="连接验证" Padding="8,6"/><TextBlock x:Name="ProjectInfo" Grid.Row="3" Grid.Column="3" VerticalAlignment="Center" Foreground="#6A7A96" TextTrimming="CharacterEllipsis"/>
 <TextBlock Grid.Row="4" Text="新接口分类" VerticalAlignment="Center"/><ComboBox x:Name="Category" Grid.Row="4" Grid.Column="1" Margin="0,4,14,4"/><CheckBox x:Name="UpdateExisting" Grid.Row="4" Grid.Column="2" Grid.ColumnSpan="2" Content="更新已有接口的参数及响应，保留名称、分类和人工说明" VerticalAlignment="Center" IsChecked="True"/>
 </Grid></Border>
 <WrapPanel Grid.Row="2" Margin="0,0,0,14"><Button x:Name="Scan" Content="扫描并预览"/><Button x:Name="Upload" Content="上传勾选接口"/><Button x:Name="QuickUpload" Content="重新扫描并上传历史选择"/><Button x:Name="SelectSafe" Content="勾选无警告项"/><TextBlock x:Name="Count" Text="等待扫描" Foreground="#8490A6" VerticalAlignment="Center"/></WrapPanel>
 <DataGrid x:Name="Apis" Grid.Row="3" IsReadOnly="False" SelectionMode="Single" Margin="0,0,0,10"><DataGrid.Columns><DataGridCheckBoxColumn Header="上传" Binding="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="60"/><DataGridTextColumn Header="方法" Binding="{Binding Method}" Width="90" IsReadOnly="True"/><DataGridTextColumn Header="路径" Binding="{Binding Path}" Width="1.4*" IsReadOnly="True"/><DataGridTextColumn Header="名称" Binding="{Binding Title}" Width="*" IsReadOnly="True"/><DataGridTextColumn Header="需确认" Binding="{Binding Warning}" Width="*" IsReadOnly="True"/><DataGridTextColumn Header="结果" Binding="{Binding Result}" Width="100" IsReadOnly="True"/></DataGrid.Columns></DataGrid>
 <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBox x:Name="Preview" IsReadOnly="True" AcceptsReturn="True" FontSize="11" Padding="8"/><TextBox x:Name="Log" Grid.Column="1" IsReadOnly="True" AcceptsReturn="True" FontSize="11" Padding="8"/></Grid>
</Grid>

