<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="MyTool · 个人工具箱" Width="1440" Height="900" MinWidth="1000" MinHeight="680" WindowState="Maximized" WindowStartupLocation="CenterScreen" Background="#F5F7FB" FontFamily="Microsoft YaHei UI" FontSize="13" Foreground="#18243B">
 <Window.Resources>
  <SolidColorBrush x:Key="Muted" Color="#8190A7"/>
  <Style TargetType="Button"><Setter Property="Cursor" Value="Hand"/><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#465571"/><Setter Property="Padding" Value="18,11"/><Setter Property="Margin" Value="0,0,10,0"/><Setter Property="BorderBrush" Value="#E2E7F0"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.78"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.58"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#5365E8"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#5365E8"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style x:Key="Nav" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#ABB7CD"/><Setter Property="BorderThickness" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Margin" Value="0,0,0,10"/><Setter Property="Padding" Value="18,15"/></Style>
  <Style TargetType="TextBox"><Setter Property="FontFamily" Value="Consolas"/><Setter Property="FontSize" Value="14"/><Setter Property="Foreground" Value="#354563"/><Setter Property="Background" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="20"/><Setter Property="AcceptsReturn" Value="True"/><Setter Property="AcceptsTab" Value="True"/><Setter Property="HorizontalScrollBarVisibility" Value="Auto"/><Setter Property="VerticalScrollBarVisibility" Value="Auto"/><Setter Property="SpellCheck.IsEnabled" Value="False"/></Style>
  <Style x:Key="Panel" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="12"/><Setter Property="BorderBrush" Value="#E4E9F2"/><Setter Property="BorderThickness" Value="1"/><Setter Property="ClipToBounds" Value="True"/></Style>
  <Style TargetType="DataGrid"><Setter Property="Background" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="RowBackground" Value="White"/><Setter Property="AlternatingRowBackground" Value="#F8FAFD"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#EDF0F6"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="RowHeight" Value="42"/><Setter Property="ColumnHeaderHeight" Value="42"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="AutoGenerateColumns" Value="False"/></Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#F4F6FB"/><Setter Property="Foreground" Value="#738098"/><Setter Property="Padding" Value="16,10"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style TargetType="DataGridCell"><Setter Property="Padding" Value="16,10"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}"><ContentPresenter/></Border></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="224"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#141E33"><Grid Margin="22,30,22,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel><StackPanel Orientation="Horizontal"><Border Background="#6675F5" CornerRadius="10" Width="38" Height="38"><TextBlock Text="M" FontSize="23" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="12,0,0,0"><TextBlock Text="MyTool" FontSize="21" FontWeight="Bold" Foreground="White"/><TextBlock Text="PERSONAL WORKSPACE" FontSize="8" Foreground="#7F8DA9" Margin="0,3,0,0"/></StackPanel></StackPanel>
   <TextBlock Text="工作空间" Foreground="#64738F" FontSize="11" Margin="14,48,0,16"/>
   <Button x:Name="NavHome" Style="{StaticResource Nav}" Content="⌂    工具概览"/>
   <Button x:Name="NavFormat" Style="{StaticResource Nav}" Content="{}{ }    JSON 格式化"/>
   <Button x:Name="NavDiff" Style="{StaticResource Nav}" Content="⇄    JSON Diff"/><Button x:Name="NavText" Style="{StaticResource Nav}" Content="≡    文本比对"/><Button x:Name="NavYapi" Style="{StaticResource Nav}" Content="↥    接口导入 YApi"/>
   </StackPanel>
   <Border Grid.Row="2" CornerRadius="10" Background="#1D2941" Padding="14"><StackPanel><TextBlock Text="●  本地工作模式" Foreground="#8EDBB8" FontSize="12"/><TextBlock Text="数据留在你的设备上" Foreground="#8796B2" FontSize="11" Margin="0,8,0,0"/><TextBlock Text="MyTool  /  v1.3.0" Foreground="#64738F" FontSize="10" Margin="0,20,0,0"/></StackPanel></Border>
  </Grid></Border>
  <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="66"/><RowDefinition Height="*"/><RowDefinition Height="42"/></Grid.RowDefinitions>
   <Border Background="White" BorderBrush="#E6EAF2" BorderThickness="0,0,0,1" Padding="32,0"><DockPanel VerticalAlignment="Center"><TextBlock x:Name="Breadcrumb" Text="工作空间  /  工具概览" Foreground="#7B879D" FontSize="12"/><TextBlock Text="●  离线可用" Foreground="#659A83" HorizontalAlignment="Right" FontSize="11"/></DockPanel></Border>
   <Grid Grid.Row="1" Margin="32,28,32,12">
    <ScrollViewer x:Name="HomePage" VerticalScrollBarVisibility="Auto"><StackPanel>
     <TextBlock Text="让日常开发，轻松一点。" FontSize="29" FontWeight="Bold" Margin="0,0,0,10"/>
     <TextBlock Text="专注好用的小工具，打开即用。" Foreground="#8190A7" FontSize="14"/>
     <Border CornerRadius="16" Padding="24" Margin="0,22,0,22"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#E5E9FF" Offset="0"/><GradientStop Color="#EDF3FF" Offset="0.6"/><GradientStop Color="#E1F4F1" Offset="1"/></LinearGradientBrush></Border.Background><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="YOUR EVERYDAY TOOLKIT" FontSize="10" Foreground="#6774BC" FontWeight="Bold"/><TextBlock Text="小工具，大效率" FontSize="25" FontWeight="Bold" Margin="0,14,0,10"/><TextBlock Text="从整理一段 JSON，到定位每一处数据变化。" Foreground="#73809F"/><StackPanel Orientation="Horizontal" Margin="0,22,0,0"><Border Background="#FFFFFF" CornerRadius="5" Padding="10,5" Margin="0,0,8,0"><TextBlock Text="完全本地" FontSize="11" Foreground="#6473AB"/></Border><Border Background="#FFFFFF" CornerRadius="5" Padding="10,5"><TextBlock Text="无需安装" FontSize="11" Foreground="#6473AB"/></Border></StackPanel></StackPanel><TextBlock Grid.Column="1" Text="{}{  }" FontFamily="Consolas" FontSize="65" FontWeight="Bold" Foreground="#8E9AE0" Opacity="0.55" VerticalAlignment="Center" HorizontalAlignment="Center"/></Grid></Border>
     <DockPanel Margin="0,0,0,18"><TextBlock Text="全部工具" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="04  个工具" Foreground="#9BA6BA" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/></DockPanel>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource Panel}" Padding="25"><StackPanel><Border Background="#EEF0FF" CornerRadius="12" Width="52" Height="52" HorizontalAlignment="Left"><TextBlock Text="{}{ }" FontFamily="Consolas" FontSize="23" FontWeight="Bold" Foreground="#6370E6" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="JSON 格式化" FontSize="20" FontWeight="SemiBold" Margin="0,14,0,8"/><TextBlock Text="把杂乱的数据，整理成清晰的结构。" Foreground="#8490A6" TextWrapping="Wrap"/><TextBlock Text="格式化 · 压缩 · 校验 · 文件导出" Foreground="#A1AABD" FontSize="11" Margin="0,10,0,18"/><Button x:Name="OpenFormat" Content="打开工具   →" Style="{StaticResource Primary}" HorizontalAlignment="Left"/></StackPanel></Border>
      <Border Grid.Column="2" Style="{StaticResource Panel}" Padding="25"><StackPanel><Border Background="#E7F5F2" CornerRadius="12" Width="52" Height="52" HorizontalAlignment="Left"><TextBlock Text="⇄" FontSize="29" Foreground="#399E8B" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="JSON Diff" FontSize="20" FontWeight="SemiBold" Margin="0,14,0,8"/><TextBlock Text="看清两份 JSON 之间的每一处变化。" Foreground="#8490A6" TextWrapping="Wrap"/><TextBlock Text="结构比较 · 路径定位 · 变化分类" Foreground="#A1AABD" FontSize="11" Margin="0,10,0,18"/><Button x:Name="OpenDiff" Content="打开工具   →" HorizontalAlignment="Left"/></StackPanel></Border>
     </Grid>
     <Border Style="{StaticResource Panel}" Padding="22" Margin="0,18,0,0"><DockPanel><Button x:Name="OpenText" Content="打开工具   →" HorizontalAlignment="Right" DockPanel.Dock="Right"/><StackPanel><TextBlock Text="≡  文本比对" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="逐行对齐文本，直接高亮新增、删除和修改的内容。" Foreground="#8490A6" Margin="0,8,0,0" TextWrapping="Wrap"/></StackPanel></DockPanel></Border><Border Style="{StaticResource Panel}" Padding="22" Margin="0,18,0,0"><DockPanel><Button x:Name="OpenYapi" Content="打开工具   →" DockPanel.Dock="Right"/><StackPanel><TextBlock Text="↥  接口导入 YApi" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="解析 Controller、预览接口，保存配置后可直接同步。" Foreground="#8490A6" Margin="0,8,0,0"/></StackPanel></DockPanel></Border><TextBlock Text="为你的专注而设计。更多实用工具，持续加入。" Foreground="#A2ACBD" FontSize="11" Margin="0,28,0,20"/>
    </StackPanel></ScrollViewer>
    <Grid x:Name="YapiHost" Visibility="Collapsed"/><Grid x:Name="ToolPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <StackPanel Margin="0,0,0,22"><TextBlock x:Name="ToolTitle" FontSize="27" FontWeight="Bold"/><TextBlock x:Name="ToolSubtitle" Foreground="#8490A6" Margin="0,9,0,0" TextWrapping="Wrap"/></StackPanel>
     <WrapPanel Grid.Row="1" Margin="0,0,0,20"><Button x:Name="Run" Style="{StaticResource Primary}"/><Button x:Name="Compress" Content="压缩"/><Button x:Name="Validate" Content="校验 JSON"/><Button x:Name="Example" Content="试试示例"/><Button x:Name="Swap" Content="交换两侧"/><Button x:Name="Clear" Content="清空"/><Button x:Name="EditInput" Content="返回编辑" Visibility="Collapsed"/><TextBlock x:Name="CompareLegend" Text="绿色 新增  ·  红色 删除  ·  黄色 修改" Foreground="#8490A6" FontSize="11" VerticalAlignment="Center" Visibility="Collapsed"/></WrapPanel>
     <Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition x:Name="ResultSpacer" Height="0"/><RowDefinition x:Name="ResultRow" Height="0"/></Grid.RowDefinitions>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Border Style="{StaticResource Panel}"><Grid><Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition Height="*"/><RowDefinition Height="32"/></Grid.RowDefinitions><Border BorderBrush="#EDF0F6" BorderThickness="0,0,0,1" Padding="18,0"><DockPanel VerticalAlignment="Center"><Button x:Name="LoadLeft" Content="打开文件" Padding="10,5" FontSize="11" DockPanel.Dock="Right" Margin="0"/><TextBlock x:Name="LeftTitle" Text="输入 JSON" VerticalAlignment="Center" FontWeight="SemiBold"/></DockPanel></Border><TextBox x:Name="LeftEditor" Grid.Row="1"/><RichTextBox x:Name="LeftHighlight" Grid.Row="1" Visibility="Collapsed" IsReadOnly="True" BorderThickness="0" FontFamily="Consolas, Microsoft YaHei UI" FontSize="14" Foreground="#354563" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="12"/><TextBlock x:Name="LeftCount" Grid.Row="2" Text="0 个字符" Foreground="#9AA5B9" FontSize="10" Margin="18,5,0,0"/></Grid></Border>
       <Border Grid.Column="2" Style="{StaticResource Panel}"><Grid><Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition Height="*"/><RowDefinition Height="32"/></Grid.RowDefinitions><Border BorderBrush="#EDF0F6" BorderThickness="0,0,0,1" Padding="18,0"><DockPanel VerticalAlignment="Center"><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button x:Name="LoadRight" Content="打开文件" Padding="10,5" FontSize="11" Margin="0"/><Button x:Name="Copy" Content="复制" Padding="10,5" FontSize="11"/><Button x:Name="Save" Content="保存" Padding="10,5" FontSize="11" Margin="0"/></StackPanel><TextBlock x:Name="RightTitle" VerticalAlignment="Center" FontWeight="SemiBold"/></DockPanel></Border><TextBox x:Name="RightEditor" Grid.Row="1"/><RichTextBox x:Name="RightHighlight" Grid.Row="1" Visibility="Collapsed" IsReadOnly="True" BorderThickness="0" FontFamily="Consolas, Microsoft YaHei UI" FontSize="14" Foreground="#354563" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="12"/><TextBlock x:Name="RightCount" Grid.Row="2" Text="0 个字符" Foreground="#9AA5B9" FontSize="10" Margin="18,5,0,0"/></Grid></Border>
      </Grid>
      <Border x:Name="Results" Grid.Row="2" Style="{StaticResource Panel}" Visibility="Collapsed"><Grid><Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="18,0" VerticalAlignment="Center"><TextBlock Text="差异明细" FontWeight="SemiBold"/><TextBlock x:Name="Summary" Text="等待比较" Foreground="#8A95AB" HorizontalAlignment="Right" FontSize="11"/></DockPanel><DataGrid x:Name="DiffGrid" Grid.Row="1"><DataGrid.Columns><DataGridTextColumn Header="变化" Binding="{Binding Kind}" Width="100"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#7C66CD"/><Style.Triggers><DataTrigger Binding="{Binding Kind}" Value="新增"><Setter Property="Foreground" Value="#279E79"/></DataTrigger><DataTrigger Binding="{Binding Kind}" Value="删除"><Setter Property="Foreground" Value="#D5687C"/></DataTrigger></Style.Triggers></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn><DataGridTextColumn Header="JSON 路径" Binding="{Binding Path}" Width="1.2*"/><DataGridTextColumn Header="原始值" Binding="{Binding Before}" Width="*"/><DataGridTextColumn Header="新值" Binding="{Binding After}" Width="*"/></DataGrid.Columns></DataGrid><TextBlock x:Name="EmptyResult" Grid.Row="1" Text="点击「比较差异」，在这里查看变化" Foreground="#A1ABBE" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/></Grid></Border>
     </Grid>
    </Grid>
   </Grid>
   <DockPanel Grid.Row="2" Margin="32,0"><TextBlock x:Name="Status" Text="就绪" FontSize="11" Foreground="#8490A6" VerticalAlignment="Center"/><TextBlock Text="●  数据仅在本机处理" FontSize="10" Foreground="#92A0B4" HorizontalAlignment="Right" VerticalAlignment="Center"/></DockPanel>
  </Grid>
 </Grid>
</Window>




